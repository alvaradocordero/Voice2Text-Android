<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer for the adaptive launcher icon — a white microphone
  (fitting for a speech-to-text app). The mic path uses the standard
  24x24 Material design icon, scaled x3 and offset by 18 so it sits
  centred within the 108x108 canvas's 72x72 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3"
        android:scaleY="3"
        android:translateX="18"
        android:translateY="18">
        <!-- Microphone capsule -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3z" />
        <!-- Microphone cradle, stem and base -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39,-0.49 6,-3.39 6,-6.92h-2z" />
    </group>
</vector>
